{
  "schema": 1,
  "about": "Where each agent's on-disk format and hook contract were checked. Gate: scripts/catalog_check.py. Weekly sentinel: scripts/vendor_drift.py.",
  "agents": {
    "claude": {
      "source": "docs",
      "urls": [
        "https://code.claude.com/docs/en/hooks",
        "https://code.claude.com/docs/en/cli-reference"
      ],
      "checked": "2026-09-29",
      "tests": [
        "AttentionTests.swift",
        "NativeHarvestSelfTest.swift"
      ],
      "note": "Closed source; transcripts are the documented JSONL and hooks are the documented events.",
      "hooks": {
        "source": "docs",
        "urls": [
          "https://code.claude.com/docs/en/hooks"
        ],
        "checked": "2026-09-29",
        "note": "Every Pulse entry runs async: true — an async hook cannot block or decide (\"Run hooks in the background\"). PostToolUse replaces PreToolUse for activity.",
        "events": [
          "SessionStart",
          "SessionEnd",
          "UserPromptSubmit",
          "PostToolUse",
          "PermissionRequest",
          "Notification",
          "Stop",
          "StopFailure"
        ]
      }
    },
    "codex": {
      "source": "repo",
      "repo": "https://github.com/openai/codex",
      "commit": "0d7b8117d3cc6d9ffe21d22375d70307133e9f16",
      "checked": "2026-09-29",
      "watch": [
        "codex-rs/core/src/rollout.rs",
        "codex-rs/protocol/src/protocol.rs"
      ],
      "tests": [
        "VendorFormatTests.swift",
        "NativeHarvestSelfTest.swift"
      ],
      "hooks": {
        "source": "repo",
        "repo": "https://github.com/openai/codex",
        "commit": "193632d2448f6b0e9860faab8d6495124e266772",
        "checked": "2026-09-29",
        "watch": [
          "codex-rs/hooks/src/engine/discovery.rs",
          "codex-rs/hooks/src/schema.rs",
          "codex-rs/hooks/src/legacy_notify.rs"
        ],
        "note": "hooks.json shares Claude's nested shape and honours async (SessionEnd always runs synchronously, capped at 3 s). PermissionRequest is never installed: it fires before Codex's own auto-review. The legacy notify argv (agent-turn-complete) stays.",
        "events": [
          "SessionStart",
          "SessionEnd",
          "UserPromptSubmit",
          "Stop"
        ]
      }
    },
    "cursor": {
      "source": "unverified",
      "why": "Closed source; the composer store in state.vscdb is undocumented and read as found.",
      "hooks": {
        "source": "docs",
        "urls": [
          "https://cursor.com/docs/hooks"
        ],
        "checked": "2026-09-29",
        "note": "cursor.com was unreachable from the build environment on 2026-09-29; event names and payload fields (conversation_id, workspace_roots, transcript_path, status) were cross-checked against third-party typed bindings (pkg.go.dev/github.com/Checkmarx/ast-cx-hooks/cursor, github.com/speakeasy-api/gram server/design/hooks). beforeSubmitPrompt can stop a prompt and is not installed. Re-read the docs on a machine that can reach them.",
        "events": [
          "sessionStart",
          "sessionEnd",
          "afterAgentResponse",
          "stop"
        ]
      }
    },
    "pi": {
      "source": "repo",
      "repo": "https://github.com/badlogic/pi-mono",
      "commit": "b485fa3128c3d8dae87cb59da6e95db0f991c5bc",
      "checked": "2026-09-29",
      "watch": [
        "packages/coding-agent/src/core/session-manager.ts",
        "packages/ai/src/types.ts"
      ],
      "tests": [
        "VendorFormatTests.swift",
        "NativeHarvestSelfTest.swift"
      ],
      "hooks": {
        "source": "repo",
        "repo": "https://github.com/badlogic/pi-mono",
        "commit": "312184edb68c38248e1acfc3eec68500ba49d9cb",
        "checked": "2026-09-29",
        "watch": [
          "packages/coding-agent/docs/extensions.md",
          "packages/coding-agent/src/core/extensions/types.ts"
        ],
        "note": "Extension events are notifications when the handler returns nothing; ui_prompt_start/ui_prompt_end are Pi's own report of a blocking user-facing prompt.",
        "events": [
          "session_start",
          "session_shutdown",
          "agent_start",
          "tool_execution_end",
          "ui_prompt_start",
          "ui_prompt_end",
          "agent_settled"
        ]
      }
    },
    "gemini": {
      "source": "repo",
      "repo": "https://github.com/google-gemini/gemini-cli",
      "commit": "fe6350238c1862dade66a9dea9080c6508475bec",
      "checked": "2026-09-29",
      "watch": [
        "packages/core/src/services/chatRecordingService.ts",
        "packages/core/src/services/chatRecordingTypes.ts",
        "packages/core/src/config/storage.ts",
        "packages/core/src/config/projectRegistry.ts"
      ],
      "tests": [
        "VendorFormatTests.swift",
        "HarvestTests.swift",
        "NativeHarvestSelfTest.swift"
      ],
      "hooks": {
        "source": "repo",
        "repo": "https://github.com/google-gemini/gemini-cli",
        "commit": "d75234cae935d58f896f4dbf305e0c51602fa385",
        "checked": "2026-09-29",
        "watch": [
          "docs/hooks/reference.md",
          "docs/hooks/index.md"
        ],
        "note": "Exit 0 with empty stdout passes every event; only exit 2 or a decision in stdout blocks. Notification is observability only. Hooks run with a sanitized environment, so terminal handles may be missing.",
        "events": [
          "SessionStart",
          "SessionEnd",
          "BeforeAgent",
          "AfterAgent",
          "Notification"
        ]
      }
    },
    "copilot": {
      "source": "repo",
      "repo": "https://github.com/github/copilot-sdk",
      "commit": "d3e90e04cd2c973dcb490889f8ecd85ce61b7611",
      "checked": "2026-09-29",
      "watch": [
        "nodejs/src/generated/session-events.ts"
      ],
      "tests": [
        "VendorFormatTests.swift"
      ],
      "note": "Storage layout from github/docs copilot-cli config-dir reference.",
      "hooks": {
        "source": "repo",
        "repo": "https://github.com/github/docs",
        "commit": "394068dacf2ea33d383fee605dc87aa48441305e",
        "checked": "2026-09-29",
        "watch": [
          "content/copilot/reference/hooks-reference.md"
        ],
        "note": "camelCase event names select the camelCase payload. notification is fire-and-forget; agentStop/sessionStart outputs are ignored when stdout is empty. agent_idle/agent_completed describe background subagents and are not read as the session's turn.",
        "events": [
          "sessionStart",
          "sessionEnd",
          "userPromptSubmitted",
          "agentStop",
          "notification",
          "errorOccurred"
        ]
      }
    },
    "opencode": {
      "source": "repo",
      "repo": "https://github.com/anomalyco/opencode",
      "commit": "7945de208964a49300d7f770d1a71d078db9a4c4",
      "checked": "2026-09-29",
      "watch": [
        "packages/core/src/session/sql.ts",
        "packages/core/src/database/schema.gen.ts",
        "packages/opencode/src/session/processor.ts",
        "packages/schema/src/v1/session.ts"
      ],
      "tests": [
        "VendorFormatTests.swift",
        "NativeHarvestSelfTest.swift"
      ],
      "hooks": {
        "source": "repo",
        "repo": "https://github.com/anomalyco/opencode",
        "commit": "7945de208964a49300d7f770d1a71d078db9a4c4",
        "checked": "2026-09-29",
        "watch": [
          "packages/web/src/content/docs/plugins.mdx",
          "packages/sdk/js/src/v2/gen/types.gen.ts",
          "packages/plugin/src/index.ts",
          "packages/opencode/src/plugin/index.ts"
        ],
        "note": "A legacy plugin module: every named export is a plugin function. Only the event hook is used; it never throws and never awaits the child it spawns.",
        "events": [
          "session.created",
          "session.status",
          "session.idle",
          "session.error",
          "session.deleted",
          "permission.asked",
          "permission.replied",
          "question.asked",
          "question.replied",
          "question.rejected"
        ]
      }
    }
  }
}
