<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened runtime refuses Apple Events without this; TerminalFocus
	     asks Terminal / iTerm2 to select the session's tab. Not a
	     com.apple.developer.* entitlement, so ad-hoc builds still launch. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
